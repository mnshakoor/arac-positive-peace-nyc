---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:media="http://search.yahoo.com/mrss/">
  <channel>
    <title>{{ site.title | xml_escape }}</title>
    <link>{{ '/' | absolute_url }}</link>
    <atom:link href="{{ '/feed.xml' | absolute_url }}" rel="self" type="application/rss+xml" />
    <description>{{ site.description | strip_newlines | xml_escape }}</description>
    <language>{{ site.lang }}</language>
    <lastBuildDate>{{ site.time | date_to_rfc822 }}</lastBuildDate>
    {%- assign stories = site.nyc_events | concat: site.press_media | sort: "date" | reverse %}
    {%- for s in stories limit: 50 %}
    {%- assign author = site.data.team | where: "slug", s.author | first %}
    <item>
      <title>{{ s.title | xml_escape }}</title>
      <link>{{ s.url | absolute_url }}</link>
      <guid isPermaLink="true">{{ s.url | absolute_url }}</guid>
      <pubDate>{{ s.date | date_to_rfc822 }}</pubDate>
      <dc:creator>{{ author.name | default: site.organization.name | xml_escape }}</dc:creator>
      <category>{{ s.category | xml_escape }}</category>
      <description>{{ s.description | xml_escape }}</description>
      {%- if s.image %}
      <media:content url="{{ s.image | absolute_url }}" medium="image"><media:description>{{ s.image_alt | xml_escape }}</media:description></media:content>
      {%- endif %}
    </item>
    {%- endfor %}
  </channel>
</rss>
